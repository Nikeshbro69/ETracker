model User { 
  id    String     @id @default(uuid()) 
  name  String?
  email String  @unique
  password String
  createdAt DateTime @default(now())
  role Role[]
} 

model Role {
  id    Int     @id @default(autoincrement())
  role  String  @unique
  userId Int
  user User @relation(fields: [userId], references: [id])
}